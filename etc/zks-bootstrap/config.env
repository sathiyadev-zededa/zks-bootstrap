ZEDCONTROL_HOST="zedcontrol.thor.zededa.dev"
ZEDCONTROL_INSECURE=0   # 0=verify TLS (default), 1=allow insecure (curl --insecure) to ZEDEDA endpoint
K3S_REGISTRY_HOST="forgejo-zks.local.zededa.net"
K3S_REGISTRY_INSECURE_SKIP_VERIFY=1  # 1=write registries.yaml with insecure_skip_verify
ZKS_CLUSTER_NAME="edge-$(hostname -s)"
ZKS_PROJECT_ID="dac6ad75-3eaa-4040-831a-e61ea075f386"
ZKS_API_TOKEN=""
K3S_VERSION="v1.34.2+k3s1"
K3S_MODE="server"
K3S_NODE_NAME="$(hostname -s)"
K3S_OFFLINE=1   #0=online, 1=install from the pre-packed binary
K3S_ARTIFACT_DIR="/usr/share/zks-bootstrap/k3s"
K3S_INSTALL_SH="/usr/share/zks-bootstrap/install.sh"

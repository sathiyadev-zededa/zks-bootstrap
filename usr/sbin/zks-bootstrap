#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${CONFIG_FILE:-/etc/zks-bootstrap/config.env}"
TOKEN_FILE="${TOKEN_FILE:-/etc/zks-bootstrap/session.token}"
AUTH_TOKEN_FILE="${AUTH_TOKEN_FILE:-/etc/zks-bootstrap/auth.token}"

: "${ZEDCONTROL_HOST:=zedcontrol.thor.zededa.dev}"
: "${ZKS_CLUSTER_NAME:=}"
: "${ZKS_PROJECT_ID:=}"
: "${K3S_VERSION:=v1.29.7+k3s1}"
: "${K3S_MODE:=server}"               
: "${K3S_NODE_NAME:=$(hostname -s)}"
: "${KUBECONFIG:=/etc/rancher/k3s/k3s.yaml}"

: "${ZKS_API_TOKEN:=}"
: "${USERNAME:=}"
: "${PASSWORD:=}"
: "${EXPIRES_SECONDS:=7776000}"

base_url="https://${ZEDCONTROL_HOST}"

log() { echo "[$(date -Is)] $*"; }

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || { echo "ERROR: missing required command: $1"; exit 1; }
}

have_cmd() { command -v "$1" >/dev/null 2>&1; }

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
  fi
}

curl_json() {
  local method="$1"; shift
  local url="$1"; shift
  local token="${1:-}"; shift || true
  local body="${1:-}"

  if [[ -n "$token" ]]; then
    if [[ -n "$body" ]]; then
      curl -sS -X "$method" "$url" \
        -H "Authorization: Bearer ${token}" \
        -H "Content-Type: application/json" \
        --data "$body"
    else
      curl -sS -X "$method" "$url" \
        -H "Authorization: Bearer ${token}" \
        -H "Content-Type: application/json"
    fi
  else
    if [[ -n "$body" ]]; then
      curl -sS -X "$method" "$url" \
        -H "Content-Type: application/json" \
        --data "$body"
    else
      curl -sS -X "$method" "$url" \
        -H "Content-Type: application/json"
    fi
  fi
}

ensure_dirs() {
  mkdir -p /etc/zks-bootstrap
  chmod 700 /etc/zks-bootstrap || true
}

is_arm64() {
  case "$(uname -m)" in
    aarch64|arm64) return 0 ;;
    *) return 1 ;;
  esac
}

install_pkg_if_missing() {
  local cmd="$1"
  local pkg="$2"

  if have_cmd "$cmd"; then
    return 0
  fi

  log "Installing dependency: $pkg (missing $cmd)..."
  if have_cmd apt-get; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y "$pkg"
  elif have_cmd apt; then
    export DEBIAN_FRONTEND=noninteractive
    apt update -y
    apt install -y "$pkg"
  else
    log "ERROR: No apt/apt-get found; install $pkg manually."
    return 1
  fi
}

ensure_k3s_snapshotter_arm() {
  if ! is_arm64; then
    return 0
  fi

  log "ARM64 detected: preparing k3s containerd snapshotter config..."
  install_pkg_if_missing fuse-overlayfs fuse-overlayfs || true

  if [[ ! -e /dev/fuse ]]; then
    log "/dev/fuse missing; attempting to load fuse module..."
    if have_cmd modprobe; then
      modprobe fuse || true
    fi
  fi

  mkdir -p /etc/rancher/k3s
  local cfg="/etc/rancher/k3s/config.yaml"

  if [[ -f "$cfg" ]] && grep -qE '^[[:space:]]*snapshotter:[[:space:]]*' "$cfg"; then
    log "k3s config already has snapshotter set; leaving as-is: $cfg"
    return 0
  fi

  local snap="fuse-overlayfs"
  if ! have_cmd fuse-overlayfs || [[ ! -e /dev/fuse ]]; then
    log "fuse-overlayfs not usable (missing binary or /dev/fuse). Using snapshotter=native"
    snap="native"
  fi

  log "Writing $cfg with snapshotter: $snap"
  cat >"$cfg" <<YAML
snapshotter: $snap
YAML
  chmod 0644 "$cfg" || true
}

install_k3s() {
  if command -v k3s >/dev/null 2>&1; then
    log "k3s already installed; skipping install."
    return
  fi

  log "Installing k3s ${K3S_VERSION} (${K3S_MODE})..."
  curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${K3S_VERSION}" sh -s - "${K3S_MODE}" \
    --node-name "${K3S_NODE_NAME}"
}

wait_k3s_ready() {
  log "Waiting for kubeconfig..."
  for i in {1..180}; do
    [[ -s "$KUBECONFIG" ]] && break
    sleep 2
  done

  log "Waiting for apiserver readiness (/readyz) stable..."
  local ok=0
  for i in {1..240}; do
    if kubectl --kubeconfig "$KUBECONFIG" get --raw='/readyz' >/dev/null 2>&1; then
      ok=$((ok+1))
      [[ $ok -ge 5 ]] && break
    else
      ok=0
    fi
    sleep 2
  done

  log "Waiting for node to be Ready..."
  for i in {1..240}; do
    if kubectl --kubeconfig "$KUBECONFIG" get nodes 2>/dev/null | grep -q " Ready "; then
      log "Node is Ready."
      return 0
    fi
    sleep 2
  done

  log "ERROR: k3s did not become ready in time."
  kubectl --kubeconfig "$KUBECONFIG" get nodes -o wide || true
  journalctl -u k3s -b --no-pager -n 200 || true
  exit 1
}

get_session_token() {
  if [[ -n "${ZKS_API_TOKEN}" ]]; then
    echo "${ZKS_API_TOKEN}"
    return
  fi

  if [[ -f "$TOKEN_FILE" ]]; then
    cat "$TOKEN_FILE"
    return
  fi

  if [[ -z "${USERNAME}" || -z "${PASSWORD}" ]]; then
    log "ERROR: Need either ZKS_API_TOKEN OR USERNAME/PASSWORD."
    exit 1
  fi

  log "Logging in to create session token..."
  require_cmd jq

  login_resp="$(curl_json POST "${base_url}/api/v1/login" "" \
    "$(jq -n --arg u "$USERNAME" --arg p "$PASSWORD" '{usernameAtRealm:$u, password:$p}')" \
  )"

  auth_token="$(echo "$login_resp" | jq -r '.token.base64 // empty')"
  enterprise_id="$(echo "$login_resp" | jq -r '.detailedUser.enterpriseId // empty')"

  if [[ -z "$auth_token" || -z "$enterprise_id" ]]; then
    log "ERROR: login response missing token or enterpriseId"
    echo "$login_resp" | jq .
    exit 1
  fi

  session_resp="$(curl_json POST "${base_url}/api/v1/sessions/token/self" "$auth_token" \
    "$(jq -n --arg eid "$enterprise_id" --argjson exp "$EXPIRES_SECONDS" '{enterpriseId:$eid, expires:$exp}')" \
  )"

  session_token="$(echo "$session_resp" | jq -r '.apiToken.base64 // empty')"
  if [[ -z "$session_token" ]]; then
    log "ERROR: session response missing apiToken.base64"
    echo "$session_resp" | jq .
    exit 1
  fi

  echo "$session_token" >"$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"
  echo "$session_token"
}

zks_import_post() {
  local token="$1"
  require_cmd jq

  local payload
  payload="$(jq -n \
    --arg name "$ZKS_CLUSTER_NAME" \
    --arg projectId "$ZKS_PROJECT_ID" \
    '{name:$name, projectId:$projectId}'
  )"

  curl_json POST "${base_url}/api/v1/zks/instances/import" "$token" "$payload"
}

zks_import_manifest_get() {
  local token="$1"
  local instance_id="$2"

  curl -sS -X GET "${base_url}/api/v1/zks/instances/id/${instance_id}/registration-commands" \
    -H "Authorization: Bearer ${token}" \
    -H "Accept: application/json"
}

zks_instance_get_by_name() {
  local token="$1"
  local zksname="$2"

  curl -sS -X GET \
    "${base_url}/api/v1/zks/instances/status?zksname=${zksname}&next.orderBy=name:ASC" \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json"
}

apply_manifest() {
  local manifest_url="$1"
  log "Applying ZKS import manifest to cluster..."

  if ! curl -sfL "$manifest_url" | kubectl --kubeconfig "$KUBECONFIG" apply -f -; then
    curl --insecure -sfL "$manifest_url" | kubectl --kubeconfig "$KUBECONFIG" apply -f -
  fi
}

wait_zks_online() {
  local token="$1"
  local zksname="$2"

  log "Waiting for ZKS cluster '$zksname' to become ONLINE..."

  for i in {1..180}; do
    local resp runState
    resp="$(curl -sS -X GET \
      "${base_url}/api/v1/zks/instances/status?zksname=${zksname}&next.orderBy=name:ASC" \
      -H "Authorization: Bearer ${token}" \
      -H "Content-Type: application/json" \
      || true
    )"

    if ! echo "$resp" | jq -e . >/dev/null 2>&1; then
      log "ZKS status: <unknown> (non-JSON / transient response)"
      sleep 5
      continue
    fi

    runState="$(echo "$resp" | jq -r '.list[0].runState // empty')"
    [[ -z "$runState" ]] && log "ZKS runState: <unknown>" || log "ZKS runState: $runState"

    case "$runState" in
      RUN_STATE_ONLINE) return 0 ;;
      RUN_STATE_ERROR)
        log "ZKS reports ERROR state. Dumping response:"
        echo "$resp" | jq . 1>&2
        return 1
        ;;
    esac

    sleep 5
  done

  log "WARNING: cluster did not reach RUN_STATE_ONLINE within timeout."
  return 1
}

main() {
  require_cmd curl
  require_cmd jq

  load_config
  ensure_dirs

  if [[ -z "${ZKS_CLUSTER_NAME}" || -z "${ZKS_PROJECT_ID}" ]]; then
    log "ERROR: ZKS_CLUSTER_NAME and ZKS_PROJECT_ID must be set."
    exit 1
  fi

  # ARM-only overlay workaround
  ensure_k3s_snapshotter_arm

  install_k3s
  require_cmd kubectl

  wait_k3s_ready

  local token
  token="$(get_session_token)"

  log "Calling ZKS import POST..."
  local import_resp instance_id
  import_resp="$(zks_import_post "$token")"
  instance_id="$(echo "$import_resp" | jq -r '.objectId // .id // empty')"

  if [[ -z "$instance_id" ]]; then
    log "ERROR: import response missing instance id. Response:"
    echo "$import_resp" | jq .
    exit 1
  fi

  log "Import instance id: $instance_id"
  log "Fetching import manifest (GET)..."
  local response manifest_url
  response="$(zks_import_manifest_get "$token" "$instance_id")"
  manifest_url="$(echo "$response" | jq -r '.manifestUrl // empty')"

  if [[ -z "$manifest_url" ]]; then
    log "ERROR: registration-commands response missing manifestUrl. Response:"
    echo "$response" | jq .
    exit 1
  fi

  apply_manifest "$manifest_url"
  wait_zks_online "$token" "$ZKS_CLUSTER_NAME" || true
  log "Bootstrap complete."
}

main "$@"

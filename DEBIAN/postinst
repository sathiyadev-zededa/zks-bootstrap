#!/bin/sh
set -e

LOG=/var/log/zks-bootstrap-install.log
mkdir -p /var/log

echo "[postinst] zks-bootstrap installing..."

mkdir -p /etc/zks-bootstrap
chmod 700 /etc/zks-bootstrap || true

if [ -f /etc/zks-bootstrap/config.env ]; then
  chmod 600 /etc/zks-bootstrap/config.env || true
fi

chmod 0755 /usr/sbin/zks-bootstrap || true

# If systemd is available, install as a oneshot service that will
# handle retries and logging via journald, instead of running inline
# during dpkg.
if command -v systemctl >/dev/null 2>&1; then
  echo "[postinst] detected systemd; enabling zks-bootstrap.service"
  systemctl daemon-reload || true
  systemctl enable zks-bootstrap.service || true
  # Start once in the background; it will resume from state on failures.
  systemctl start zks-bootstrap.service || true
else
  echo "[postinst] systemd not found; running zks-bootstrap directly"
  /usr/sbin/zks-bootstrap >> "$LOG" 2>&1 || true
fi

echo "[postinst] done."
exit 0

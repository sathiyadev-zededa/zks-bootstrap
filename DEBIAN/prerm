#!/bin/sh
set -e

echo "[prerm] zks-bootstrap removing runtime tokens..."
rm -f /etc/zks-bootstrap/session.token /etc/zks-bootstrap/auth.token 2>/dev/null || true
case "$1" in
  remove|deconfigure)
    echo "[prerm] Uninstalling K3s if present..."

    if [ -x /usr/local/bin/k3s-uninstall.sh ]; then
        /usr/local/bin/k3s-uninstall.sh || true
    else
        echo "[prerm] k3s-uninstall.sh not found, skipping"
    fi
    ;;
esac
echo "[prerm] done."
exit 0
